{
  "rewrites": [
    {
      "source": "/api/logout",
      "destination": "/api/login?action=logout"
    },
    {
      "source": "/api/empresas",
      "destination": "/api/admin?resource=empresas"
    },
    {
      "source": "/api/empresas/:id",
      "destination": "/api/admin?resource=empresas&id=:id"
    },
    {
      "source": "/api/usuarios",
      "destination": "/api/admin?resource=usuarios"
    },
    {
      "source": "/api/usuarios/:id",
      "destination": "/api/admin?resource=usuarios&id=:id"
    },
    {
      "source": "/api/admin/sin-empresa",
      "destination": "/api/admin?resource=sin-empresa"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/salud",
      "schedule": "23 12 * * *"
    }
  ]
}
