---
import '../styles/global.css';
import { SITIO } from '../lib/sitio';

interface Props {
  titulo: string;
  descripcion?: string;
  seccion?: 'cursos' | 'progreso' | 'ayuda' | null;
}
const { titulo, descripcion = 'Cursos para el uso seguro de los equipos biomédicos.', seccion = null } = Astro.props;
const tituloCompleto = titulo === SITIO.nombre ? titulo : `${titulo} | ${SITIO.nombre}`;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#F6F8F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121A21" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{tituloCompleto}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Ir al contenido</a>
    <header class="cabecera">
      <div class="contenedor cabecera-fila">
        <a class="marca" href="/">
          <span class="marca-sello" aria-hidden="true">CB</span>
          <span>{SITIO.nombre}</span>
        </a>
        <nav aria-label="Principal">
          <ul>
            <li><a href="/" aria-current={seccion === 'cursos' ? 'page' : undefined}>Cursos</a></li>
            <li><a href="/#calendario">Calendario</a></li>
            <li><a href="/ayuda/" aria-current={seccion === 'ayuda' ? 'page' : undefined}>Ayuda</a></li>
            <li><a href="/mi-progreso/" aria-current={seccion === 'progreso' ? 'page' : undefined}>Mi progreso</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie-fila">
        <p>{SITIO.area}. Cursos con control documental: código, versión y fecha de vigencia.</p>
        <ul>
          <li><a href="/ayuda/">Ayuda</a></li>
          <li><a href="/ayuda/#contacto">Contacto del área</a></li>
          <li><a href="/tratamiento-de-datos/">Tratamiento de datos personales</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    padding: 0.5rem 1rem;
    background: var(--acento);
    color: var(--sobre-acento);
    border-radius: var(--r-control);
    z-index: 10;
  }
  .saltar:focus { top: 0.5rem; }

  main:focus { outline: none; }

  .cabecera {
    border-bottom: 1px solid var(--linea);
    background: var(--superficie);
    padding-top: env(safe-area-inset-top);
  }
  .cabecera-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    min-height: 64px;
    padding-block: 0.5rem;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--tinta);
    text-decoration: none;
    font-family: var(--f-titulo);
    font-stretch: 112%;
    font-weight: 600;
    min-height: 44px;
  }
  .marca-sello {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--acero);
    border-radius: var(--r-placa);
    font-size: var(--t-xs);
    letter-spacing: 0.02em;
    color: var(--acento);
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.6rem;
    color: var(--tinta-2);
    text-decoration: none;
    border-radius: var(--r-control);
    white-space: nowrap;
  }
  nav a[aria-current='page'] {
    color: var(--tinta);
    box-shadow: inset 0 -2px 0 var(--acento);
    border-radius: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover { color: var(--tinta); }
  }
  @media (max-width: 560px) {
    nav { width: 100%; margin-inline: -0.6rem; }
  }

  .pie {
    margin-top: 4rem;
    border-top: 1px solid var(--linea);
    background: var(--superficie);
    color: var(--tinta-2);
    font-size: var(--t-xs);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .pie-fila {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }
  .pie ul { display: flex; flex-wrap: wrap; gap: 0 1.25rem; list-style: none; margin: 0; padding: 0; }
  .pie a { color: var(--tinta-2); display: inline-block; padding-block: 0.6rem; }
</style>
