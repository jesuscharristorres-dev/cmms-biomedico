---
import Base from '../../../layouts/Base.astro';
import Icono from '../../../components/Icono.astro';
import Visor from '../../../components/Visor.astro';
import Video from '../../../components/Video.astro';
import FormularioPerfil from '../../../components/FormularioPerfil.astro';
import { cursosOrdenados, CATEGORIAS, laminasMigradas, pdfDisponible, fechaCorta, type Curso } from '../../../lib/cursos';
import { SITIO } from '../../../lib/sitio';

export async function getStaticPaths() {
  const cursos = await cursosOrdenados();
  return cursos.map((curso) => ({ params: { categoria: curso.categoria, equipo: curso.equipo }, props: { curso } }));
}

const { curso: c } = Astro.props as { curso: Curso };
const laminas = laminasMigradas(c);
const pdf = pdfDisponible(c) ? c.pdf : null;
const pasos = ['Pre test', 'Material', 'Video', 'Pos test', 'Certificado'];
const minimo = Math.ceil((SITIO.notaAprobacion / 100) * SITIO.preguntasPosTest);
---
<Base titulo={c.titulo} descripcion={c.objetivo} seccion="cursos">
  <div
    class="contenedor curso"
    data-curso={c.codigo}
    data-titulo={c.titulo}
    data-version={c.version}
    data-tiene-pre={String(!!c.pre_test)}
    data-tiene-pos={String(!!c.pos_test)}
    data-tiene-video={String(!!c.video)}
  >
    <header class="curso-cabeza">
      <nav aria-label="Ruta" class="miga">
        <a href={`/?categoria=${c.categoria}`}>{CATEGORIAS[c.categoria]}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{c.titulo}</span>
      </nav>
      <h1>{c.titulo}</h1>
      <p class="objetivo"><strong>Objetivo:</strong> {c.objetivo}</p>
      <dl class="ficha">
        <div><dt>Código</dt><dd class="num">{c.codigo}</dd></div>
        <div><dt>Versión</dt><dd class="num">{c.version}</dd></div>
        <div><dt>Vigente desde</dt><dd class="num">{fechaCorta(c.actualizado)}</dd></div>
        <div><dt>Responsable</dt><dd>{c.responsable}</dd></div>
      </dl>
    </header>

    <aside class="riel" aria-label="Ruta del curso">
      <h2 class="riel-titulo">Ruta del curso</h2>
      <ol class="pasos">
        {pasos.map((p, i) => (
          <li>
            <a href={`#paso-${i + 1}`} class="paso" data-paso={i + 1} data-estado="bloqueado">
              <span class="paso-marca num" aria-hidden="true">
                <span class="paso-n">{i + 1}</span>
                <Icono nombre="check" class="paso-check" />
                <Icono nombre="lock" class="paso-candado" />
              </span>
              <span class="paso-nombre">{p}</span>
              <span class="sr-only paso-estado-texto"></span>
            </a>
          </li>
        ))}
      </ol>
      <p class="riel-progreso num" aria-live="polite"></p>
      <button type="button" class="boton boton-primario riel-continuar" data-continuar><span data-continuar-texto>Continuar</span></button>
    </aside>

    <div class="paneles">
      <section id="paso-1" class="panel" aria-labelledby="t-paso-1" tabindex="-1">
        <h2 id="t-paso-1"><span class="num">1.</span> Pre test</h2>
        <div data-sin-perfil hidden>
          <p class="panel-bajada">Antes de empezar, identifícate. Tus datos aparecen en el certificado.</p>
          <FormularioPerfil />
        </div>
        <div data-con-perfil hidden>
          <p class="panel-bajada">Cinco preguntas para saber cuánto conoces del equipo antes del curso. No tiene nota mínima.</p>
          <p class="saludo" data-saludo></p>
          {c.pre_test ? (
            <div class="acciones">
              <a class="boton boton-secundario" href={c.pre_test} target="_blank" rel="noopener">Abrir pre test <span class="sr-only">(se abre en una pestaña nueva)</span></a>
              <button type="button" class="boton boton-primario" data-marcar="pre">Ya respondí el pre test</button>
            </div>
          ) : (
            <>
              <div class="aviso aviso-senal"><Icono nombre="clock" /><p>El pre test de este curso está en preparación. Puedes continuar con el material.</p></div>
              <div class="acciones"><button type="button" class="boton boton-primario" data-marcar="pre">Continuar al material</button></div>
            </>
          )}
        </div>
      </section>

      <section id="paso-2" class="panel" aria-labelledby="t-paso-2" tabindex="-1">
        <h2 id="t-paso-2"><span class="num">2.</span> Material</h2>
        {laminas.length > 0 ? (
          <Visor laminas={laminas} titulo={c.titulo} />
        ) : (
          <div class="aviso aviso-senal">
            <Icono nombre="clock" />
            <p>Las <span class="num">{c.laminas}</span> láminas de este curso se están trasladando desde el sitio anterior. Mientras tanto, consúltalas en <a href={SITIO.sitioAnterior}>formacionbiomedica.wordpress.com</a>.</p>
          </div>
        )}
        <div class="acciones">
          {pdf && (
            <a class="boton boton-secundario" href={pdf} download data-descarga>
              <Icono nombre="download" /> Descargar PDF
            </a>
          )}
          <button type="button" class="boton boton-primario" data-marcar="material">Terminé el material</button>
        </div>
      </section>

      <section id="paso-3" class="panel" aria-labelledby="t-paso-3" tabindex="-1">
        <h2 id="t-paso-3"><span class="num">3.</span> Video</h2>
        {c.video ? (
          <Video id={c.video} titulo={c.titulo} />
        ) : (
          <div class="aviso aviso-senal">
            <Icono nombre="clock" />
            <p>{c.video_existente
              ? 'El video de este curso se está trasladando desde el sitio anterior.'
              : 'El video de este curso está en producción. Puedes continuar con el pos test.'}</p>
          </div>
        )}
        <div class="acciones"><button type="button" class="boton boton-primario" data-marcar="video">{c.video ? 'Terminé el video' : 'Continuar al pos test'}</button></div>
      </section>

      <section id="paso-4" class="panel" aria-labelledby="t-paso-4" tabindex="-1">
        <h2 id="t-paso-4"><span class="num">4.</span> Pos test</h2>
        <p class="panel-bajada"><span class="num">{SITIO.preguntasPosTest}</span> preguntas. Apruebas con <span class="num">{SITIO.notaAprobacion} %</span> o más (<span class="num">{minimo}</span> correctas). Tienes <span class="num">{SITIO.intentosPosTest}</span> intentos.</p>
        {c.pos_test ? (
          <>
            <ol class="instrucciones">
              <li>Abre el pos test y respóndelo con el mismo documento que registraste.</li>
              <li>Al enviarlo, el formulario te muestra tu puntaje. Regístralo aquí.</li>
            </ol>
            <div class="acciones">
              <a class="boton boton-secundario" href={c.pos_test} target="_blank" rel="noopener">Abrir pos test <span class="sr-only">(se abre en una pestaña nueva)</span></a>
            </div>
            <form class="puntaje" data-puntaje novalidate>
              <label for="puntaje">Respuestas correctas</label>
              <div class="puntaje-fila">
                <input id="puntaje" name="puntaje" type="number" inputmode="numeric" min="0" max={SITIO.preguntasPosTest} required aria-describedby="puntaje-de" />
                <span id="puntaje-de" class="num">de {SITIO.preguntasPosTest}</span>
                <button type="submit" class="boton boton-primario">Registrar resultado</button>
              </div>
              <p class="error" data-puntaje-error hidden>Escribe un número entre 0 y {SITIO.preguntasPosTest}.</p>
            </form>
            <div data-resultado aria-live="polite"></div>
          </>
        ) : (
          <div class="aviso aviso-senal"><Icono nombre="clock" /><p>El enlace del pos test de este curso se está trasladando. Mientras tanto, respóndelo desde <a href={SITIO.sitioAnterior}>el sitio anterior</a>.</p></div>
        )}
      </section>

      <section id="paso-5" class="panel" aria-labelledby="t-paso-5" tabindex="-1">
        <h2 id="t-paso-5"><span class="num">5.</span> Certificado</h2>
        <div data-cert-bloqueado>
          <p class="panel-bajada">El certificado se habilita al aprobar el pos test.</p>
        </div>
        <div data-cert-listo hidden>
          <div class="aviso"><Icono nombre="award" /><p>Aprobaste el curso. Tu certificado tiene un código de control que Ingeniería biomédica coteja con el registro del pos test.</p></div>
          <div class="acciones"><button type="button" class="boton boton-primario" data-abrir-cert>Ver certificado</button></div>
        </div>
      </section>
    </div>
  </div>

  <script is:inline define:vars={{ codigo: c.codigo }}>
    // Antes de pintar: panel activo y bloque de identificación, para que no haya saltos de layout.
    (function () {
      var leer = function (k) { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } };
      var perfil = leer('cb:perfil');
      var p = leer('cb:progreso:' + codigo) || {};
      var intentos = (p.intentos || []).length;
      var e = [
        p.pre ? 'c' : 'd',
        p.material ? 'c' : p.pre ? 'd' : 'b',
        p.video ? 'c' : p.material ? 'd' : 'b',
        p.aprobadoEn ? 'c' : (intentos ? 'd' : (p.material && perfil ? 'd' : 'b')),
        p.aprobadoEn ? 'c' : 'b'
      ];
      var sug = e.indexOf('d') + 1 || (e[4] === 'c' ? 5 : 1);
      var h = Number((location.hash.match(/^#paso-(\d)$/) || [])[1]);
      var n = h && e[h - 1] !== 'b' ? h : sug;
      var panel = document.getElementById('paso-' + n);
      if (panel) panel.classList.add('activo');
      var sin = document.querySelector('[data-sin-perfil]');
      var con = document.querySelector('[data-con-perfil]');
      if (sin && con) { sin.hidden = !!perfil; con.hidden = !perfil; }
    })();
  </script>

  <dialog class="modal" aria-labelledby="cert-titulo" data-modal-cert>
    <article class="certificado">
      <header class="cert-cabeza">
        <span class="num">{c.codigo}</span>
        <span class="num">v{c.version}</span>
      </header>
      <p class="cert-org">{SITIO.area}</p>
      <h2 id="cert-titulo">Certificado de capacitación</h2>
      <p class="cert-texto">Se certifica que <strong data-cert="nombre"></strong>, con documento <strong class="num" data-cert="documento"></strong>, <span data-cert="cargo"></span> del servicio <span data-cert="servicio"></span> (sede <span data-cert="sede"></span>), aprobó el curso</p>
      <p class="cert-curso">{c.titulo}</p>
      <dl class="ficha cert-ficha">
        <div><dt>Fecha de aprobación</dt><dd class="num" data-cert="fecha"></dd></div>
        <div><dt>Resultado</dt><dd class="num" data-cert="puntaje"></dd></div>
        <div><dt>Vigencia</dt><dd class="num" data-cert="vigencia"></dd></div>
        <div><dt>Código de control</dt><dd class="num" data-cert="codigo"></dd></div>
      </dl>
    </article>
    <div class="modal-acciones">
      <button type="button" class="boton boton-secundario" data-cerrar-cert>Cerrar</button>
      <button type="button" class="boton boton-primario" data-imprimir-cert><Icono nombre="printer" /> Imprimir o guardar PDF</button>
    </div>
  </dialog>
</Base>

<style>
  .curso {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding-top: 2rem;
  }
  @media (min-width: 960px) {
    .curso {
      grid-template-columns: minmax(0, 8fr) minmax(0, 3fr);
      column-gap: 2.5rem;
      align-items: start;
    }
    .curso-cabeza, .paneles { grid-column: 1; }
    .riel { grid-column: 2; grid-row: 1 / span 2; position: sticky; top: 1.5rem; }
  }

  .curso-cabeza { display: grid; gap: 0.9rem; }
  .miga { display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: var(--t-xs); color: var(--tinta-2); }
  .miga a { color: var(--tinta-2); }
  .objetivo { font-size: var(--t-m); line-height: 1.45; }
  .objetivo strong { font-weight: 600; }

  .ficha {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 0;
    border: 1px solid var(--acero);
    border-radius: var(--r-placa);
    background: var(--superficie);
    font-size: var(--t-xs);
  }
  .ficha div { padding: 0.55rem 0.8rem; border-right: 1px solid var(--linea); }
  .ficha div:last-child { border-right: 0; }
  .ficha dt { color: var(--tinta-2); }
  .ficha dd { margin: 0; font-weight: 600; font-size: var(--t-s); }
  @media (max-width: 639px) {
    .ficha { grid-template-columns: 1fr 1fr; }
    .ficha div:nth-child(2n) { border-right: 0; }
    .ficha div:nth-child(-n + 2) { border-bottom: 1px solid var(--linea); }
  }

  /* Riel: columna fija en escritorio, barra superior en celular */
  .riel {
    border: 1px solid var(--acero);
    border-radius: var(--r-placa);
    background: var(--superficie);
    padding: 1rem;
    display: grid;
    gap: 0.75rem;
  }
  .riel-titulo { font-size: var(--t-s); }
  .pasos { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .paso {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.25rem 0.5rem;
    border-radius: var(--r-control);
    color: var(--tinta);
    text-decoration: none;
  }
  .paso-marca {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    display: grid;
    place-items: center;
    border: 1px solid var(--acero);
    border-radius: var(--r-placa);
    font-size: var(--t-xs);
    font-weight: 600;
    transition: background-color 220ms var(--ease-out), border-color 220ms var(--ease-out), color 220ms var(--ease-out);
  }
  .paso-marca > :global(*) { grid-area: 1 / 1; }
  .paso-marca :global(svg) { width: 1rem; height: 1rem; }
  .paso-marca :global(.paso-check) {
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
  }
  .paso-marca :global(.paso-candado) { display: none; }
  .paso-n { transition: opacity 120ms ease; }

  .paso[data-estado='bloqueado'] { color: var(--tinta-2); }
  .paso[data-estado='bloqueado'] .paso-n { display: none; }
  .paso[data-estado='bloqueado'] .paso-marca { border-color: var(--linea); }
  .paso[data-estado='bloqueado'] .paso-marca :global(.paso-candado) { display: block; }

  .paso[aria-current='step'] { background: var(--acento-suave); font-weight: 600; }
  .paso[aria-current='step'] .paso-marca { border-color: var(--acento); color: var(--acento); }

  .paso[data-estado='completado'] .paso-marca { background: var(--acento); border-color: var(--acento); color: var(--sobre-acento); }
  .paso[data-estado='completado'] .paso-n { opacity: 0; }
  .paso[data-estado='completado'] .paso-marca :global(.paso-check) { opacity: 1; transform: scale(1); }

  .paso[data-estado='atencion'] .paso-marca { border-color: var(--senal); background: var(--senal-suave); }

  @media (hover: hover) and (pointer: fine) {
    .paso:not([data-estado='bloqueado']):not([aria-current='step']):hover { background: var(--fondo); }
  }

  .riel-progreso { font-size: var(--t-xs); color: var(--tinta-2); }

  @media (max-width: 959px) {
    .curso { padding-top: 0; }
    .curso-cabeza { padding-top: 0.5rem; }
    .riel {
      position: sticky;
      top: 0;
      z-index: 2;
      grid-row: 1;
      margin-inline: calc(-1 * var(--gutter));
      border-inline: 0;
      border-top: 0;
      border-radius: 0;
      padding: 0.5rem var(--gutter);
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .riel-titulo, .riel-progreso { display: none; }
    .pasos { grid-template-columns: repeat(5, auto); justify-content: start; gap: 0.25rem; }
    .paso { padding: 0 0.35rem; gap: 0; }
    .paso-nombre { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .paso[aria-current='step'] { padding-right: 0.6rem; gap: 0.5rem; }
    .paso[aria-current='step'] .paso-nombre { position: static; width: auto; height: auto; clip: auto; }
    .riel-continuar { min-height: 40px; padding-inline: 0.9rem; }
  }
  @media (max-width: 400px) {
    .paso[aria-current='step'] .paso-nombre { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .paso[aria-current='step'] { padding-right: 0.35rem; }
  }

  .paneles { display: grid; gap: 2.5rem; }
  .panel { display: grid; gap: 1rem; scroll-margin-top: 5rem; align-content: start; }
  .panel :global(.perfil) { margin-top: 0.5rem; }
  .panel:focus { outline: none; }
  .panel h2 .num { color: var(--tinta-2); }
  :global(html.js) .panel:not(.activo) { display: none; }
  .paneles.navegando .panel.activo { animation: panel-entra 200ms var(--ease-out); }
  @keyframes panel-entra { from { opacity: 0; } }

  .panel-bajada { color: var(--tinta-2); }
  .saludo { font-weight: 600; }
  .acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .instrucciones { margin: 0; padding-left: 1.25rem; display: grid; gap: 0.35rem; max-width: 70ch; }

  .puntaje { display: grid; gap: 0.4rem; }
  .puntaje label { font-weight: 600; }
  .puntaje-fila { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .puntaje input {
    width: 5.5rem;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: max(16px, 1rem);
    font-variant-numeric: tabular-nums;
    color: var(--tinta);
    background: var(--superficie);
    border: 1px solid var(--acero);
    border-radius: var(--r-control);
  }
  .puntaje input[aria-invalid='true'] { border-color: var(--error); }
  .error { font-size: var(--t-xs); color: var(--error); font-weight: 600; }

  /* Modal de certificado: desde scale(0.96) + opacidad, centrado, 240 ms */
  .modal {
    width: min(720px, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid var(--acero);
    border-radius: var(--r-placa);
    background: var(--superficie);
    color: var(--tinta);
    box-shadow: 0 24px 48px -12px oklch(26% 0.025 251 / 0.28);
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 240ms var(--ease-out), transform 240ms var(--ease-out), overlay 240ms allow-discrete, display 240ms allow-discrete;
  }
  .modal[open] { opacity: 1; transform: scale(1); }
  .modal:not([open]) { transition-duration: 160ms; }
  @starting-style { .modal[open] { opacity: 0; transform: scale(0.96); } }
  .modal::backdrop {
    background: oklch(26% 0.025 251 / 0.45);
    opacity: 0;
    transition: opacity 240ms var(--ease-out), overlay 240ms allow-discrete, display 240ms allow-discrete;
  }
  .modal[open]::backdrop { opacity: 1; }
  @starting-style { .modal[open]::backdrop { opacity: 0; } }

  .certificado { padding: 2rem; display: grid; gap: 0.9rem; }
  .cert-cabeza {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--linea);
    font-size: var(--t-xs);
    color: var(--tinta-2);
  }
  .cert-org { font-size: var(--t-xs); color: var(--tinta-2); }
  .cert-texto { line-height: 1.6; }
  .cert-curso { font-family: var(--f-titulo); font-stretch: 112%; font-weight: 600; font-size: var(--t-xl); line-height: 1.15; }
  .cert-ficha { margin-top: 0.5rem; grid-template-columns: 1fr 1fr; }
  .cert-ficha div:nth-child(2n) { border-right: 0; }
  .cert-ficha div:nth-child(-n + 2) { border-bottom: 1px solid var(--linea); }
  .modal-acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1rem 2rem 1.5rem;
    border-top: 1px solid var(--linea);
  }

  @media print {
    :global(body.imprimiendo) > :global(*:not(dialog)) { display: none !important; }
    :global(body.imprimiendo) { background: var(--superficie); }
    .modal { position: static; width: 100%; max-height: none; border: 0; box-shadow: none; transform: none; opacity: 1; color: var(--tinta); background: var(--superficie); }
    .modal::backdrop { display: none; }
    .modal-acciones { display: none; }
  }
</style>

<script>
  import { leerPerfil, leerProgreso, actualizarProgreso, codigoCertificado, type ProgresoCurso } from '../../../lib/progreso';
  import { SITIO } from '../../../lib/sitio';

  const raiz = document.querySelector<HTMLElement>('[data-curso]')!;
  const codigo = raiz.dataset.curso!;
  const paneles = [...document.querySelectorAll<HTMLElement>('.panel')];
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('.paso')];
  const continuar = document.querySelector<HTMLButtonElement>('[data-continuar]')!;
  const progresoTexto = document.querySelector<HTMLElement>('.riel-progreso')!;
  const minimo = Math.ceil((SITIO.notaAprobacion / 100) * SITIO.preguntasPosTest);

  type EstadoPaso = 'bloqueado' | 'disponible' | 'completado' | 'atencion';

  function estados(p: ProgresoCurso): EstadoPaso[] {
    const perfil = !!leerPerfil();
    const agotado = !p.aprobadoEn && p.intentos.length >= SITIO.intentosPosTest;
    return [
      p.pre ? 'completado' : 'disponible',
      p.material ? 'completado' : p.pre ? 'disponible' : 'bloqueado',
      p.video ? 'completado' : p.material ? 'disponible' : 'bloqueado',
      p.aprobadoEn ? 'completado' : agotado || p.intentos.length ? 'atencion' : p.material && perfil ? 'disponible' : 'bloqueado',
      p.aprobadoEn ? 'completado' : 'bloqueado',
    ];
  }

  const TEXTO: Record<EstadoPaso, string> = {
    bloqueado: 'bloqueado', disponible: 'disponible', completado: 'completado', atencion: 'requiere atención',
  };

  function pasoSugerido(e: EstadoPaso[]): number {
    const i = e.findIndex((s) => s === 'disponible' || s === 'atencion');
    return i === -1 ? (e[4] === 'completado' ? 5 : 1) : i + 1;
  }

  let actual = 1;

  function pintar(enfocar = false) {
    const p = leerProgreso(codigo);
    const e = estados(p);
    if (e[actual - 1] === 'bloqueado') actual = pasoSugerido(e);

    enlaces.forEach((a, i) => {
      a.dataset.estado = e[i];
      a.querySelector('.paso-estado-texto')!.textContent = `, ${TEXTO[e[i]]}`;
      if (i + 1 === actual) a.setAttribute('aria-current', 'step'); else a.removeAttribute('aria-current');
      if (e[i] === 'bloqueado') a.setAttribute('aria-disabled', 'true'); else a.removeAttribute('aria-disabled');
    });
    paneles.forEach((s, i) => s.classList.toggle('activo', i + 1 === actual));

    const hechos = e.filter((s) => s === 'completado').length;
    progresoTexto.textContent = `${hechos} de 5 pasos completados`;

    const siguiente = pasoSugerido(e);
    continuar.hidden = siguiente === actual || e[4] === 'completado' && actual === 5;
    continuar.querySelector('[data-continuar-texto]')!.textContent = siguiente > actual ? 'Continuar' : `Ir al paso ${siguiente}`;
    continuar.dataset.destino = String(siguiente);

    // Paso 1: identificación o pre test
    const perfil = leerPerfil();
    document.querySelector<HTMLElement>('[data-sin-perfil]')!.hidden = !!perfil;
    document.querySelector<HTMLElement>('[data-con-perfil]')!.hidden = !perfil;
    if (perfil) document.querySelector('[data-saludo]')!.textContent = `Hola, ${perfil.nombre.split(' ')[0]}.`;

    // Paso 4: resultado
    pintarResultado(p);

    // Paso 5
    document.querySelector<HTMLElement>('[data-cert-bloqueado]')!.hidden = !!p.aprobadoEn;
    document.querySelector<HTMLElement>('[data-cert-listo]')!.hidden = !p.aprobadoEn;

    if (enfocar) paneles[actual - 1].focus({ preventScroll: true });
    if (enfocar && matchMedia('(max-width: 959px)').matches) {
      paneles[actual - 1].scrollIntoView({ block: 'start' });
    }
  }

  function pintarResultado(p: ProgresoCurso) {
    const caja = document.querySelector<HTMLElement>('[data-resultado]');
    const form = document.querySelector<HTMLFormElement>('[data-puntaje]');
    if (!caja || !form) return;
    const ultimo = p.intentos.at(-1);
    const restantes = SITIO.intentosPosTest - p.intentos.length;
    form.hidden = !!p.aprobadoEn || restantes <= 0;
    if (ultimo === undefined) { caja.replaceChildren(); return; }
    const div = document.createElement('div');
    if (p.aprobadoEn) {
      div.className = 'aviso';
      div.textContent = `Aprobado con ${ultimo} de ${SITIO.preguntasPosTest}. Tu certificado está listo.`;
    } else if (restantes > 0) {
      div.className = 'aviso aviso-error';
      div.textContent = `No aprobado: ${ultimo} de ${SITIO.preguntasPosTest} (mínimo ${minimo}). Te ${restantes === 1 ? 'queda 1 intento' : `quedan ${restantes} intentos`}. Repasa el material antes de volver a intentarlo.`;
    } else {
      div.className = 'aviso aviso-error';
      div.textContent = `Usaste los ${SITIO.intentosPosTest} intentos sin aprobar. Comunícate con ${SITIO.area} para programar un refuerzo.`;
    }
    caja.replaceChildren(div);
  }

  function ir(n: number, enfocar = true, animar = true) {
    const e = estados(leerProgreso(codigo));
    if (e[n - 1] === 'bloqueado') return;
    actual = n;
    document.querySelector('.paneles')!.classList.toggle('navegando', animar);
    history.replaceState(null, '', `#paso-${n}`);
    pintar(enfocar);
  }

  // Con teclado (detail 0) se cambia de paso sin animación
  enlaces.forEach((a, i) => a.addEventListener('click', (ev) => { ev.preventDefault(); ir(i + 1, true, ev.detail > 0); }));
  continuar.addEventListener('click', () => ir(Number(continuar.dataset.destino)));

  const avanzar = (campo: 'pre' | 'material' | 'video', siguiente: number) => {
    actualizarProgreso(codigo, { [campo]: true });
    ir(siguiente);
  };
  document.querySelector('[data-marcar="pre"]')?.addEventListener('click', () => avanzar('pre', 2));
  document.querySelector('[data-marcar="material"]')?.addEventListener('click', () => avanzar('material', 3));
  document.querySelector('[data-marcar="video"]')?.addEventListener('click', () => avanzar('video', 4));
  document.addEventListener('visor:final', () => { if (!leerProgreso(codigo).material) { actualizarProgreso(codigo, { material: true }); pintar(); } });
  document.querySelector('[data-descarga]')?.addEventListener('click', () => { actualizarProgreso(codigo, { material: true }); pintar(); });
  document.addEventListener('video:iniciado', () => { actualizarProgreso(codigo, { video: true }); pintar(); });
  document.addEventListener('perfil:guardado', () => pintar(true));

  // Registro del pos test
  const formPuntaje = document.querySelector<HTMLFormElement>('[data-puntaje]');
  formPuntaje?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const input = formPuntaje.querySelector<HTMLInputElement>('input')!;
    const error = formPuntaje.querySelector<HTMLElement>('[data-puntaje-error]')!;
    const n = Number(input.value);
    const valido = input.value !== '' && Number.isInteger(n) && n >= 0 && n <= SITIO.preguntasPosTest;
    input.setAttribute('aria-invalid', String(!valido));
    error.hidden = valido;
    if (!valido) { input.focus(); return; }
    const p = leerProgreso(codigo);
    const intentos = [...p.intentos, n];
    if (n >= minimo) {
      const perfil = leerPerfil();
      const fecha = new Date().toISOString().slice(0, 10);
      const cert = perfil ? await codigoCertificado(codigo, perfil.documento, fecha) : null;
      actualizarProgreso(codigo, { intentos, aprobadoEn: fecha, certificado: cert });
      input.value = '';
      ir(5);
    } else {
      actualizarProgreso(codigo, { intentos });
      input.value = '';
      pintar();
    }
  });

  // Certificado
  const modal = document.querySelector<HTMLDialogElement>('[data-modal-cert]')!;
  function llenarCertificado() {
    const p = leerProgreso(codigo);
    const perfil = leerPerfil();
    if (!p.aprobadoEn || !perfil) return false;
    const fecha = new Date(`${p.aprobadoEn}T12:00:00`);
    const vence = new Date(fecha);
    vence.setMonth(vence.getMonth() + SITIO.vigenciaMeses);
    const f = (d: Date) => d.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });
    const valores: Record<string, string> = {
      nombre: perfil.nombre,
      documento: perfil.documento,
      cargo: perfil.cargo,
      servicio: perfil.servicio,
      sede: perfil.sede,
      fecha: f(fecha),
      puntaje: `${p.intentos.at(-1)} de ${SITIO.preguntasPosTest}`,
      vigencia: `Hasta ${f(vence)}`,
      codigo: p.certificado ?? 'Pendiente',
    };
    modal.querySelectorAll<HTMLElement>('[data-cert]').forEach((el) => { el.textContent = valores[el.dataset.cert!] ?? ''; });
    return true;
  }
  document.querySelector('[data-abrir-cert]')?.addEventListener('click', async () => {
    const p = leerProgreso(codigo);
    const perfil = leerPerfil();
    if (p.aprobadoEn && !p.certificado && perfil) {
      actualizarProgreso(codigo, { certificado: await codigoCertificado(codigo, perfil.documento, p.aprobadoEn) });
    }
    if (llenarCertificado()) modal.showModal();
  });
  modal.querySelector('[data-cerrar-cert]')!.addEventListener('click', () => modal.close());
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  modal.querySelector('[data-imprimir-cert]')!.addEventListener('click', () => {
    document.body.classList.add('imprimiendo');
    window.print();
  });
  addEventListener('afterprint', () => document.body.classList.remove('imprimiendo'));

  // Estado inicial: paso del hash o el sugerido
  const desdeHash = Number(location.hash.match(/^#paso-(\d)$/)?.[1]);
  actual = desdeHash || pasoSugerido(estados(leerProgreso(codigo)));
  pintar();
</script>
